<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.orafit</groupId>
  <artifactId>orafit-jdbc</artifactId>
  <version>1.0.1</version>
  <name>Orafit JDBC</name>
  <description>Oracle-oriented JDBC compatibility layer for PostgreSQL</description>
  <url>https://github.com/yukkes/orafit</url>

  <licenses>
    <license>
      <name>Orafit Proprietary License</name>
      <distribution>manual</distribution>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/yukkes/orafit.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/yukkes/orafit.git</developerConnection>
    <url>https://github.com/yukkes/orafit</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/yukkes/orafit/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <orafit.extension.version>1.0.1</orafit.extension.version>
    <!-- Numeric prefixes define load order, not versions; reserve 90-* for migration helpers. -->
    <orafit.extension.modules>00-core.sql,10-number.sql,20-datetime.sql,30-string.sql,40-regexp.sql,50-listagg.sql,60-connect-by.sql,90-migration.sql</orafit.extension.modules>
    <orafit.test.ojdbc>${project.basedir}/target/no-ojdbc.jar</orafit.test.ojdbc>

    <!-- Keep project dependencies convergent; align plugin internals by selecting plugin releases. -->
    <jsqlparser.version>5.3.218</jsqlparser.version>
    <junit.version>5.14.4</junit.version>
    <tomlj.version>1.1.1</tomlj.version>
    <postgresql.version>42.7.13</postgresql.version>
    <embedded-postgres.version>2.2.2</embedded-postgres.version>
    <embedded-postgres-binaries.version>17.10.0</embedded-postgres-binaries.version>
    <hikari.version>6.3.3</hikari.version>
    <dbcp2.version>2.13.0</dbcp2.version>
    <checker-qual.version>3.55.1</checker-qual.version>
    <slf4j.version>2.0.17</slf4j.version>
    <commons-codec.version>1.21.0</commons-codec.version>
    <commons-compress.version>1.28.0</commons-compress.version>
    <commons-io.version>2.21.0</commons-io.version>
    <commons-lang3.version>3.20.0</commons-lang3.version>

    <fmt-maven-plugin.version>2.29</fmt-maven-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <build-helper-maven-plugin.version>3.6.1</build-helper-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>${embedded-postgres-binaries.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.checkerframework</groupId>
        <artifactId>checker-qual</artifactId>
        <version>${checker-qual.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-codec</groupId>
        <artifactId>commons-codec</artifactId>
        <version>${commons-codec.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>${commons-compress.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>${commons-io.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>${commons-lang3.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.manticore-projects.jsqlformatter</groupId>
      <artifactId>jsqlparser</artifactId>
      <version>${jsqlparser.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.tomlj</groupId>
      <artifactId>tomlj</artifactId>
      <version>${tomlj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>${embedded-postgres.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-linux-amd64-alpine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikari.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-dbcp2</artifactId>
      <version>${dbcp2.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${maven-clean-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>${maven-resources-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>com.spotify.fmt</groupId>
        <artifactId>fmt-maven-plugin</artifactId>
        <version>${fmt-maven-plugin.version}</version>
        <configuration>
          <style>aosp</style>
          <skipReflowingLongStrings>true</skipReflowingLongStrings>
        </configuration>
        <executions>
          <execution>
            <id>format-check</id>
            <phase>process-sources</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>${maven-antrun-plugin.version}</version>
        <executions>
          <execution>
            <id>orafit-package</id>
            <phase>generate-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <delete dir="${project.build.directory}/orafit" quiet="true"/>
                <mkdir dir="${project.build.directory}/orafit/native"/>
                <mkdir dir="${project.build.directory}/orafit/plain"/>
                <mkdir dir="${project.build.outputDirectory}/META-INF"/>
                <copy file="${project.basedir}/LICENSE"
                      tofile="${project.build.outputDirectory}/META-INF/Orafit-LICENSE.txt"
                      overwrite="true"/>
                <copy file="${project.basedir}/THIRD_PARTY_NOTICES.md"
                      tofile="${project.build.outputDirectory}/META-INF/THIRD_PARTY_NOTICES.md"
                      overwrite="true"/>
                <copy file="${project.basedir}/third-party/jsqlparser/LICENSE-APACHE-2.0.txt"
                      tofile="${project.build.outputDirectory}/META-INF/JSqlParser-LICENSE-APACHE-2.0.txt"
                      overwrite="true"/>
                <echo file="${project.build.directory}/orafit/native/orafit.control">comment = 'Oracle compatibility runtime for Orafit'
default_version = '${orafit.extension.version}'
relocatable = false
schema = 'orafit'
superuser = false</echo>
                <concat destfile="${project.build.directory}/orafit/native/orafit--${orafit.extension.version}.sql" fixlastline="yes">
                  <header>-- Generated from extension/src. Do not edit.
-- Orafit runtime ${orafit.extension.version}

</header>
                  <filelist dir="${project.basedir}/extension/src" files="${orafit.extension.modules}"/>
                </concat>
                <concat destfile="${project.build.directory}/orafit/plain/orafit--${orafit.extension.version}.sql" fixlastline="yes">
                  <header>-- Generated from extension/src. Do not edit.
-- Plain SQL installer for Orafit runtime ${orafit.extension.version}
BEGIN;
CREATE SCHEMA IF NOT EXISTS orafit;

</header>
                  <filelist dir="${project.basedir}/extension/src" files="${orafit.extension.modules}"/>
                  <footer>
COMMIT;
</footer>
                </concat>
              </target>
            </configuration>
          </execution>

          <execution>
            <id>orafit-archive</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <tar destfile="${project.build.directory}/orafit-jdbc-${project.version}-runtime.tar.gz"
                     compression="gzip">
                  <tarfileset dir="${project.build.directory}"
                              includes="orafit/native/**,orafit/plain/**"/>
                </tar>
              </target>
            </configuration>
          </execution>

          <execution>
            <id>verify-fat-jar</id>
            <phase>verify</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <delete dir="${project.build.directory}/jar-check" quiet="true"/>
                <mkdir dir="${project.build.directory}/jar-check"/>
                <unzip src="${project.build.directory}/${project.build.finalName}.jar" dest="${project.build.directory}/jar-check"/>
                <available file="${project.build.directory}/jar-check/META-INF/services/java.sql.Driver" property="orafit.jar.driver-service"/>
                <available file="${project.build.directory}/jar-check/net/sf/jsqlparser/parser/CCJSqlParserUtil.class" property="orafit.jar.jsqlparser"/>
                <available file="${project.build.directory}/jar-check/META-INF/JSqlParser-LICENSE-APACHE-2.0.txt" property="orafit.jar.license"/>
                <available file="${project.build.directory}/jar-check/META-INF/Orafit-LICENSE.txt" property="orafit.jar.own-license"/>
                <available file="${project.build.directory}/jar-check/META-INF/THIRD_PARTY_NOTICES.md" property="orafit.jar.third-party-notices"/>
                <fail unless="orafit.jar.driver-service" message="Packaged JAR is missing JDBC driver service metadata"/>
                <fail unless="orafit.jar.jsqlparser" message="Packaged JAR is missing JSqlParser classes"/>
                <fail unless="orafit.jar.license" message="Packaged JAR is missing the JSqlParser license"/>
                <fail unless="orafit.jar.own-license" message="Packaged JAR is missing the Orafit license"/>
                <fail unless="orafit.jar.third-party-notices" message="Packaged JAR is missing third-party notices"/>
                <delete dir="${project.build.directory}/jar-check" quiet="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${build-helper-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>attach-runtime-archive</id>
            <phase>package</phase>
            <goals><goal>attach-artifact</goal></goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${project.build.directory}/orafit-jdbc-${project.version}-runtime.tar.gz</file>
                  <type>tar.gz</type>
                  <classifier>runtime</classifier>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <systemPropertyVariables>
            <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
          </systemPropertyVariables>
          <additionalClasspathElements>
            <additionalClasspathElement>${orafit.test.ojdbc}</additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Java-Version>${maven.compiler.release}</Java-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.orafit.tools.CompatibilityAnalyzer</mainClass>
                  <manifestEntries>
                    <Automatic-Module-Name>io.github.orafit.jdbc</Automatic-Module-Name>
                    <Implementation-Title>orafit-jdbc</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
